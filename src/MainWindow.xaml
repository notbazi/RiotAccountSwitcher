<Window x:Class="RiotSwitcherAccount.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/app-icon.png"
        Title="Riot Account Switcher" Width="800" Height="500"
        MinWidth="720" MinHeight="470" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" FontFamily="Segoe UI" Foreground="#F5F7FA">
    <Window.Resources>
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="#E6EEF8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="7" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#28456076"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccountCard" TargetType="Button">
            <Setter Property="Width" Value="178"/>
            <Setter Property="Height" Value="225"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F5F7FA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hover" CornerRadius="14" Background="#09131D25" Padding="8">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="#12213347"/>
                                <Setter TargetName="Hover" Property="BorderBrush" Value="#5E8EC9FF"/>
                                <Setter TargetName="Hover" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="Hover" Property="Effect">
                                    <Setter.Value><DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.35" Color="#000000"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuItemDark" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F4F6FB"/>
            <Setter Property="Background" Value="#1B2230"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <ContentPresenter ContentSource="Icon" DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                    <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 0 8" Stroke="#AEB9C9" StrokeThickness="1.5" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed"/>
                                </DockPanel>
                            </Border>
                            <Popup x:Name="SubmenuPopup" Placement="Right" HorizontalOffset="4" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#F1141D28" BorderBrush="#44546A" BorderThickness="1" CornerRadius="12" Padding="6">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#263246"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="AccountContext" Opened="AccountMenu_Opened" Background="#F0141C28" Foreground="#F5F7FA"
                     BorderBrush="#44546A" BorderThickness="1" FocusVisualStyle="{x:Null}">
            <ContextMenu.Template>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="6">
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </ContextMenu.Template>
            <ContextMenu.Resources><Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemDark}"/></ContextMenu.Resources>
            <MenuItem Header="{DynamicResource L_Rename}" Click="Rename_Click">
                <MenuItem.Icon><TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource L_DownloadIcon}" Click="DownloadIcon_Click">
                <MenuItem.Icon><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource L_CustomIcon}">
                <MenuItem.Icon><TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}"/></MenuItem.Icon>
                <MenuItem Header="VALORANT" Click="ValorantIcon_Click">
                    <MenuItem.Icon><Image Source="pack://application:,,,/Assets/avatar-valorant.png" Width="17" Height="17"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="League of Legends" Click="LeagueIcon_Click">
                    <MenuItem.Icon><Image Source="pack://application:,,,/Assets/avatar-league.png" Width="17" Height="17"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Teamfight Tactics" Click="TftIcon_Click">
                    <MenuItem.Icon><Image Source="pack://application:,,,/Assets/avatar-tft.png" Width="17" Height="17"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Neutral" Click="RiotIcon_Click">
                    <MenuItem.Icon><Image Source="pack://application:,,,/Assets/avatar-neutral.png" Width="17" Height="17"/></MenuItem.Icon>
                </MenuItem>
                <Separator>
                    <Separator.Template>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1" Background="#A88FD1" Margin="25,6,12,6"/>
                        </ControlTemplate>
                    </Separator.Template>
                </Separator>
                <MenuItem Header="{DynamicResource L_UploadCustomIcon}" Click="CustomIcon_Click">
                    <MenuItem.Icon><TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{DynamicResource L_Delete}" Click="Delete_Click" Foreground="#FF8E95">
                <MenuItem.Icon><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="#FF8E95"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <Style x:Key="ResizeHandle" TargetType="Thumb">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="#01000000"/></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Margin="10" CornerRadius="20" BorderThickness="1" BorderBrush="#4E87A8C5">
            <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.52" Color="#000000"/></Border.Effect>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F0121A27" Offset="0"/>
                    <GradientStop Color="#F0122237" Offset="0.52"/>
                    <GradientStop Color="#F018314B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid ClipToBounds="True">
                <Viewbox Stretch="Fill" IsHitTestVisible="False" Opacity="0.65">
                    <Canvas Width="960" Height="620">
                        <Path Data="M0,0 L165,0 105,82 0,120Z" Fill="#8A2B364B"/>
                        <Path Data="M0,0 L115,0 52,55 0,55Z" Fill="#782E1524"/>
                        <Path Data="M760,620 L960,448 960,620Z" Fill="#385B8AB0"/>
                        <Path Data="M650,0 L960,0 960,84 760,115Z" Fill="#182C4667"/>
                        <Path Data="M0,510 L130,395 64,620 0,620Z" Fill="#17314D68"/>
                    </Canvas>
                </Viewbox>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="62"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#01000000" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Margin="20,7,0,0" Width="48" Height="48" Background="Transparent" VerticalAlignment="Top">
                            <Image Source="pack://application:,,,/Assets/app-icon-header.png"
                                   Width="44" Height="44" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="False" />
                        </Border>
                        
                        <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Top" Margin="0,14,16,0">
                            <Button Style="{StaticResource TitleButton}" Click="Settings_Click" ToolTip="{DynamicResource L_Settings}">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                            </Button>
                            <Button Style="{StaticResource TitleButton}" Click="Minimize_Click" Content="−"/>
                            <Button Style="{StaticResource TitleButton}" Click="Close_Click" Content="×"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="Riot Account Switcher" TextAlignment="Center"
                               HorizontalAlignment="Center" FontSize="34" FontWeight="Bold" Margin="20,16,20,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>
                    <TextBlock Grid.Row="2" Text="{DynamicResource L_ChooserSubtitle}" TextAlignment="Center"
                               Foreground="#C3CEE0" FontSize="15" Margin="20,10,20,22" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>
                    <Grid Grid.Row="3" Margin="24,0,24,0">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ItemsControl x:Name="AccountTiles">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding}" Style="{StaticResource AccountCard}" Click="Profile_Click"
                                                    ContextMenu="{StaticResource AccountContext}" ToolTip="{Binding Alias}">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="146" Height="146" BorderBrush="#5C7088A6" BorderThickness="1" CornerRadius="10" Background="#161C2735">
                                                        <Grid Margin="4">
                                                            <Image Source="{Binding IconImage}" Width="136" Height="136" Stretch="UniformToFill">
                                                                <Image.Clip><RectangleGeometry Rect="0,0,136,136" RadiusX="6" RadiusY="6"/></Image.Clip>
                                                            </Image>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{Binding Alias}" Width="166" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               FontSize="14" Foreground="#F5F7FA" Margin="0,14,0,0" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding LoginLabel}" Width="166" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               FontSize="12" Foreground="#B8C4D6" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Center the plus in the same 146px-high square as the account avatars. -->
                                <Button x:Name="AddAccountButton" Click="AddAccount_Click" Width="110" Height="225" Margin="12,0,0,0"
                                        Background="Transparent" Foreground="#F5F7FA" BorderThickness="0" Cursor="Hand"
                                        ToolTip="{DynamicResource L_AddAccount}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Surface" Background="#03121C28" CornerRadius="10">
                                                <Grid Width="110" Height="146" VerticalAlignment="Top" Margin="0,15,0,0">
                                                    <Path Data="M 0,20 L 40,20 M 20,0 L 20,40" Width="40" Height="40"
                                                          Stretch="Uniform" Stroke="#F5F7FA" StrokeThickness="3.2"
                                                          StrokeStartLineCap="Square" StrokeEndLineCap="Square"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1524364C"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <TextBlock Grid.Row="4" x:Name="NoticeText" Foreground="{DynamicResource AccentBrush}"
                               FontSize="12" TextAlignment="Center" VerticalAlignment="Center" Margin="24,0"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>
        <Thumb Style="{StaticResource ResizeHandle}" Tag="Left" Width="8" HorizontalAlignment="Left" VerticalAlignment="Stretch" Cursor="SizeWE" DragDelta="Resize_DragDelta" Margin="0,12,0,12"/>
        <Thumb Style="{StaticResource ResizeHandle}" Tag="Right" Width="8" HorizontalAlignment="Right" VerticalAlignment="Stretch" Cursor="SizeWE" DragDelta="Resize_DragDelta" Margin="0,12,0,12"/>
        <Thumb Style="{StaticResource ResizeHandle}" Tag="Top" Height="8" VerticalAlignment="Top" HorizontalAlignment="Stretch" Cursor="SizeNS" DragDelta="Resize_DragDelta" Margin="12,0,12,0"/>
        <Thumb Style="{StaticResource ResizeHandle}" Tag="Bottom" Height="8" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Cursor="SizeNS" DragDelta="Resize_DragDelta" Margin="12,0,12,0"/>
        <Thumb Style="{StaticResource ResizeHandle}" Tag="TopLeft" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" DragDelta="Resize_DragDelta"/>
        <Thumb Style="{StaticResource ResizeHandle}" Tag="TopRight" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" DragDelta="Resize_DragDelta"/>
        <Thumb Style="{StaticResource ResizeHandle}" Tag="BottomLeft" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" DragDelta="Resize_DragDelta"/>
        <Thumb Style="{StaticResource ResizeHandle}" Tag="BottomRight" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="Resize_DragDelta"/>
    </Grid>
</Window>
