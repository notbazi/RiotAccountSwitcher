<Window x:Class="RiotSwitcherAccount.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/app-icon.png"
        Title="Settings" Width="580" Height="800" MinWidth="540" MinHeight="710"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" Foreground="#F2F4F8" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="SettingButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="Background" Value="#2C4361"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}" x:Name="Border">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="10" BorderBrush="#6986A2B7" BorderThickness="1" CornerRadius="18">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F018273C" Offset="0"/>
                <GradientStop Color="#F01C3553" Offset="0.6"/>
                <GradientStop Color="#F0203D61" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="7" Opacity="0.5"/></Border.Effect>
        <Grid Margin="22">
            <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="1"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
            <Grid Background="#01000000" MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource L_Settings}" VerticalAlignment="Center" FontSize="19" FontWeight="SemiBold"/>
                <Button Grid.Column="1" Content="×" FontSize="20" Width="35" Height="32" Background="Transparent" Foreground="#F2F4F8" BorderThickness="0" Click="Close_Click"/>
            </Grid>
            <Border Grid.Row="1" Background="#526275"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,0">
              <StackPanel Margin="0,0,5,0">
                <TextBlock Text="{DynamicResource L_Language}" FontSize="15" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,18">
                    <Button x:Name="EnglishButton" Content="English" Tag="en" Width="110" Margin="0,0,10,0" Style="{StaticResource SettingButton}" Click="Language_Click"/>
                    <Button x:Name="SpanishButton" Content="Español" Tag="es" Width="110" Style="{StaticResource SettingButton}" Click="Language_Click"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource L_Accent}" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource L_ColorInfo}" Foreground="#A2A9B0" FontSize="12" Margin="0,4,0,10"/>
                <StackPanel x:Name="AccentChoices" Orientation="Horizontal" Margin="0,0,0,21"/>
                <TextBlock Text="{DynamicResource L_PathSettings}" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource L_PathInfo}" TextWrapping="Wrap" Foreground="#A2A9B0" FontSize="12" Margin="0,4,0,9"/>
                <TextBox x:Name="RiotPathBox" IsReadOnly="True" Background="#243447" Foreground="#F2F4F8" BorderBrush="#667A90" BorderThickness="1" Padding="11,9" FontSize="11" Margin="0,0,0,8"/>
                <Button Content="{DynamicResource L_PathChange}" Style="{StaticResource SettingButton}" HorizontalAlignment="Left" Click="ChangePath_Click"/>
                <TextBlock Text="{DynamicResource L_ClientActions}" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,9"/>
                <CheckBox x:Name="AutoCloseBox" Content="{DynamicResource L_CloseOnOpen}" FontSize="12" Foreground="#E7EDF7" Margin="0,0,0,12"
                          Checked="AutoCloseBox_Changed" Unchecked="AutoCloseBox_Changed"/>
                <Button Content="{DynamicResource L_OpenWithoutSwitch}" Style="{StaticResource SettingButton}" HorizontalAlignment="Stretch" Click="LaunchOnly_Click" Margin="0,0,0,8"/>
                <Button Content="{DynamicResource L_Recovery}" ToolTip="{DynamicResource L_RecoveryTip}" Style="{StaticResource SettingButton}" HorizontalAlignment="Stretch" Click="Recovery_Click"/>
                <Border Height="1" Background="#57729A" Margin="0,20,0,15"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource L_MadeBy}" Foreground="#A2A9B0" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="notbazi" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Cursor="Hand" FontSize="14" ToolTip="{DynamicResource L_InstagramTip}" MouseLeftButtonUp="Instagram_Click"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
            <Button Grid.Row="3" Content="{DynamicResource L_CloseSettings}" Style="{StaticResource SettingButton}" Background="{DynamicResource AccentBrush}" Foreground="#161616" HorizontalAlignment="Right" Width="112" Click="Close_Click" Margin="0,7,0,0"/>
        </Grid>
    </Border>
</Window>
