<Window x:Class="RiotSwitcherAccount.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/app-icon.png"
        Title="Add account" Width="515" Height="690" MinWidth="490" MinHeight="635"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" ShowInTaskbar="False" Background="Transparent"
        FontFamily="Segoe UI" Foreground="#F4F7FD">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2A3D59"/>
            <Setter Property="Foreground" Value="#F4F7FD"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="41"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.83"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="#263B55"/>
            <Setter Property="Foreground" Value="#F4F7FD"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="#617A99"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,6"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F4F7FD"/>
            <Setter Property="Background" Value="#1C2B40"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#314866"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#314866"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Background" Value="#263B55"/>
            <Setter Property="Foreground" Value="#F4F7FD"/>
            <Setter Property="Height" Value="39"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropToggle" Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton"><ContentPresenter/></ControlTemplate>
                                </ToggleButton.Template>
                                <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="#617A99" BorderThickness="1" CornerRadius="9" Padding="10,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="#F4F7FD"
                                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                        <Path Grid.Column="1" Data="M0 0 L4 4 L8 0 Z" Fill="#DBE6F4" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </ToggleButton>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#F11A2A3F" BorderBrush="#647D9D" BorderThickness="1" CornerRadius="9" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="270" VerticalScrollBarVisibility="Auto"><StackPanel IsItemsHost="True"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="10" CornerRadius="20" BorderBrush="#6489B3D9" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F4162031" Offset="0"/>
                <GradientStop Color="#F4192B43" Offset="0.58"/>
                <GradientStop Color="#F4203654" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="7" Opacity="0.45"/></Border.Effect>
        <Grid Margin="24,14,24,21">
            <Grid.RowDefinitions><RowDefinition Height="49"/><RowDefinition Height="1"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#01000000" MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource L_AddAccount}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="×" FontSize="19" Width="35" Height="32" Background="Transparent" Foreground="#F4F7FD" BorderThickness="0" Click="Close_Click" Cursor="Hand"/>
            </Grid>
            <Border Grid.Row="1" Background="#466184"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,6">
                <StackPanel Margin="0,0,5,0">
                    <TextBlock Foreground="#C5D0DF" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16">
                        <Run Text="{DynamicResource L_InstructionStart}"/>
                        <Run Text="{DynamicResource L_InstructionStrong}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                        <Run Text="{DynamicResource L_InstructionEnd}"/>
                    </TextBlock>
                    <TextBlock Text="{DynamicResource L_AliasLabel}" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox x:Name="AliasBox" Style="{StaticResource Field}" ToolTip="{DynamicResource L_AliasTip}"/>
                    <TextBlock Text="{DynamicResource L_GameLabel}" FontSize="12" Margin="0,16,0,6"/>
                    <ComboBox x:Name="GameBox" Style="{StaticResource Combo}" SelectedIndex="0" SelectionChanged="GameBox_SelectionChanged">
                        <ComboBoxItem Tag="valorant"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="pack://application:,,,/Assets/avatar-valorant.png" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="VALORANT" Foreground="#F4F7FD" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="league"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="pack://application:,,,/Assets/avatar-league.png" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="League of Legends" Foreground="#F4F7FD" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="tft"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="pack://application:,,,/Assets/avatar-tft.png" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Teamfight Tactics" Foreground="#F4F7FD" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                        <ComboBoxItem Tag="riot"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="pack://application:,,,/Assets/avatar-neutral.png" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Neutral" Foreground="#F4F7FD" VerticalAlignment="Center"/></StackPanel></ComboBoxItem>
                    </ComboBox>
                    <Grid Margin="0,13,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="ChooseAvatarButton" Grid.Column="0" Content="{DynamicResource L_AvatarForNewAccount}"
                                Click="ChooseAvatar_Click" Style="{StaticResource ActionButton}"/>
                        <Button x:Name="CustomImageButton" Grid.Column="2" Content="{DynamicResource L_UploadCustomIcon}"
                                Click="CustomAvatar_Click" Style="{StaticResource ActionButton}"/>
                    </Grid>
                    <TextBlock x:Name="AvatarStatusText" Foreground="{DynamicResource AccentBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Collapsed"/>
                    <StackPanel x:Name="ProfileFieldsPanel" Margin="0,16,0,0">
                        <TextBlock Text="{DynamicResource L_IconSourceLabel}" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="RiotIdBox" Style="{StaticResource Field}" ToolTip="{DynamicResource L_IconSourceHint}"/>
                        <TextBlock Text="{DynamicResource L_OptionalIconNote}" TextWrapping="Wrap" Foreground="#B8C6D9" FontSize="11" Margin="0,7,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" FontSize="12" Visibility="Collapsed" Margin="0,8,0,2"/>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="3" Margin="0,9,0,0">
                <Button x:Name="SaveSessionButton" Style="{StaticResource ActionButton}" Background="{DynamicResource AccentBrush}" Foreground="#141926" Content="{DynamicResource L_SaveSession}" Click="Capture_Click" Margin="0,0,0,9"/>
                <Button Style="{StaticResource ActionButton}" Content="{DynamicResource L_FreshLogin}" Click="FreshLogin_Click" ToolTip="{DynamicResource L_FreshLoginTip}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
