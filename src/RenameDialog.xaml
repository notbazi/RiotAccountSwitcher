<Window x:Class="RiotSwitcherAccount.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/app-icon.png"
        Title="Riot Account Switcher" Width="420" Height="250"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" Foreground="#F2F4F8" ShowInTaskbar="False">
    <Border Margin="10" Background="#F5161616" BorderBrush="#686868" BorderThickness="1" CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.42" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="39"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="42"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#01000000" MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource L_RenameTitle}" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold"/>
                <Button Grid.Column="1" Width="32" Height="28" Content="×" FontSize="18" Cursor="Hand"
                        Background="Transparent" Foreground="#F2F4F8" BorderThickness="0" Click="Cancel_Click"/>
            </Grid>
            <Border Grid.Row="1" Background="#454545"/>
            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                <TextBlock Text="{DynamicResource L_RenameLabel}" FontSize="12.5" Margin="0,0,0,7" Foreground="#CED4DA"/>
                <TextBox x:Name="NameBox" Height="40" MaxLength="40" FontSize="13.5"
                         Padding="12,7" VerticalContentAlignment="Center"
                         Foreground="#F2F4F8" CaretBrush="{DynamicResource AccentBrush}"
                         Background="#32363C" BorderBrush="#69717C" BorderThickness="1"/>
                <TextBlock x:Name="ValidationText" Text="{DynamicResource L_RenameInvalid}"
                           Visibility="Collapsed" Foreground="#FF8389" FontSize="11.5" Margin="2,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource L_Cancel}" Background="#353535" Foreground="#F2F4F8"
                        BorderThickness="0" Height="35" Width="96" Margin="0,0,10,0" Cursor="Hand" Click="Cancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="{DynamicResource L_SaveName}" Background="{DynamicResource AccentBrush}"
                        Foreground="#151515" BorderThickness="0" Height="35" Width="125" Cursor="Hand" Click="Save_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.85"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
