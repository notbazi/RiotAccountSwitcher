<Window x:Class="RiotSwitcherAccount.ThemedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/Assets/app-icon.png"
        Title="Riot Account Switcher" Width="430" Height="230"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="Segoe UI" Foreground="#F2F4F8">
    <Border Margin="10" Background="#F5161616" BorderBrush="#615E5E" BorderThickness="1" CornerRadius="18">
        <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.45" Color="#000000"/></Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#01000000" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DialogTitle" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="×" Width="32" Height="28" FontSize="18"
                        Background="Transparent" Foreground="#F2F4F8" BorderThickness="0" Click="Close_Click"/>
            </Grid>

            <Border Grid.Row="1" Background="#474747"/>

            <Grid Grid.Row="2" Margin="0,16,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="10" Background="#28313D" VerticalAlignment="Top">
                    <TextBlock x:Name="DialogGlyph" FontFamily="Segoe MDL2 Assets" Text="&#xE946;"
                               Foreground="{DynamicResource AccentBrush}" FontSize="17"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="DialogMessage" Grid.Column="1" TextWrapping="Wrap" FontSize="13.5" LineHeight="20"/>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Width="102" Height="38" Margin="0,0,10,0"
                        Background="#343434" Foreground="#F2F4F8" BorderThickness="0" Cursor="Hand"
                        Click="Cancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="OkButton" Width="114" Height="38"
                        Background="{DynamicResource AccentBrush}" Foreground="#101010" BorderThickness="0" Cursor="Hand"
                        Click="Ok_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Btn" Background="{TemplateBinding Background}" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Btn" Property="Opacity" Value="0.88"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
